# Copy this file to "auth.properties" (same folder) and fill in the values from
# Entra admin center > App registrations > <your app> > Overview.
# auth.properties is in .gitignore - never commit the real secret.

# Directory (tenant) ID - a GUID, not the domain name
tenant.id=<tenant-id-guid>

# Application (client) ID - a GUID
client.id=<client-id-guid>

# Certificates & secrets > Client secrets > Value (NOT the "Secret ID").
# You can leave this empty-looking placeholder and set env var AUTH_CLIENT_SECRET instead.
client.secret=<client-secret-value>

# Must match EXACTLY a Redirect URI registered under Authentication > Web
redirect.uri=http://localhost:8080/auth/redirect

# Where Microsoft sends the user after sign-out (register it under Authentication too is recommended)
post.logout.redirect.uri=http://localhost:8080/
